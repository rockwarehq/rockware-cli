{
  "name": "rockware-cli",
  "version": "0.1.0",
  "description": "rw: Rockware on the command line",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "rw": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "compile": "bun build src/main.ts --compile --minify --outfile dist/rw",
    "compile:all": "tsx scripts/compile.ts",
    "formula": "tsx scripts/formula.ts"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^24.10.8",
    "graphql": "^16.14.2",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
